# Porta usada pelo Railway/Dockerfile ao servir o build (ver Dockerfile)
PORT=3000

# OPCIONAL. A URL /exec da implantação atual já vive no código, em
# src/services/agendamentoFortalecimento.ts — não é segredo, o navegador a expõe
# de qualquer jeito. Defina esta variável só para apontar a página para OUTRA
# implantação (teste, rollback) sem precisar de commit.
# Vale no BUILD, não em runtime: o Dockerfile declara o ARG correspondente e o
# Railway precisa de um deploy novo para a mudança valer.
VITE_AGENDAMENTO_FORTALECIMENTO_API=https://script.google.com/macros/s/OUTRO_ID_DE_IMPLANTACAO/exec
