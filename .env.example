# Porta usada pelo Railway/Dockerfile ao servir o build (ver Dockerfile)
PORT=3000

# URL /exec do Web App do Apps Script "Agenda Fortalecimento".
# Alimenta a página /agendamento-fortalecimento (leitura de horários e reserva).
# Sem ela a página entra no modo "agendamento em configuração" e manda para o
# WhatsApp — nada quebra. Precisa estar definida no BUILD (Vite injeta em build-time).
VITE_AGENDAMENTO_FORTALECIMENTO_API=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec
